---
/*
 * Firma in fondo a ogni release: foto, nome e sottotitolo, un paragrafo in prima persona, il bottone verso Cal
 * e un link secondario (caso studio, altrimenti /showcase/). La foto è decorativa (alt vuoto): il nome si legge una sola volta.
 * data-nasconde-float segna la sezione che nasconde la CTA flottante mentre la Firma è in vista.
 */
import { SITE } from '../../config';

interface Props {
  caseStudy?: { href: string };
}

const { caseStudy } = Astro.props;
---

<section class="firma" data-nasconde-float>
  <div class="firma-wrap">
    <div class="firma-sign">
      <div class="firma-who">
        <img class="firma-avatar" src={SITE.founderPhoto} width="48" height="48" alt="" loading="lazy" decoding="async" />
        <div>
          <b>{SITE.founder}</b>
          <span>Product Engineer · 10 anni di release in produzione</span>
        </div>
      </div>
      <p>
        In questi articoli e su LinkedIn racconto le release dei prodotti dei miei clienti. Vuoi lo stesso ritmo di
        rilasci per i tuoi prodotti? Prenota una chiamata di 30 minuti: guardiamo insieme il prodotto e ti dico se posso
        aiutarti.
      </p>
      <div class="firma-actions">
        <a class="btn btn-primary" href={SITE.calUrl} target="_blank" rel="noopener">Prenota una call di 30 min</a>
        <a class="firma-link" href={caseStudy?.href ?? '/showcase/'}>
          {caseStudy ? 'Leggi il caso studio completo' : 'Altri articoli'}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .firma { padding: 8px 0 96px; }
  .firma-wrap { max-width: 840px; margin: 0 auto; padding: 0 24px; }
  .firma-sign { border-top: 1px solid var(--line); padding-top: 40px; }
  .firma-who { display: flex; align-items: center; gap: 14px; margin-bottom: 20px; }
  .firma-avatar {
    flex: none; width: 48px; height: 48px; border-radius: 50%; object-fit: cover; background: var(--line);
  }
  .firma-who b { display: block; line-height: 1.3; }
  .firma-who span { color: var(--muted); font-size: .9rem; }
  .firma-sign p { color: var(--ink); font-size: 1.15rem; line-height: 1.65; max-width: 640px; }
  .firma-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; margin-top: 28px; }
  .firma-link { color: var(--muted); font-weight: 600; text-decoration: none; }
  .firma-link:hover { color: var(--ink); }
  /* Entrata armata, solo dissolvenza: niente spostamento, quindi uguale anche con reduced motion. */
  @media screen {
    :global([data-articolo][data-armed]) .firma-sign:not([data-in]) { opacity: 0; }
  }
  .firma-sign[data-in] { animation: firma-fade var(--dur-swap) var(--ease-out) backwards; }
  @keyframes firma-fade { from { opacity: 0; } }
</style>
