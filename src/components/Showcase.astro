---
/*
 * Sezione 04 della home («La prova»): la fila degli ultimi articoli. Sostituisce lo scroll pinnato dei casi studio.
 * Il markup contiene l'unione delle prime 8 schede di ogni tipo (D12), in ordine di data, ognuna con `data-tag`:
 * senza JS si vedono le prime 8 di «Tutti» (le altre sono `hidden`), i link funzionano e filtri e pulsante di copia
 * non ci sono. Lo script inline subito dopo la sezione, prima del primo paint, rivela i `.solo-js` e mette `data-js`;
 * il modulo in fondo aggancia filtri, feed e date relative (src/scripts/showcase.ts).
 * La sezione non usa `.reveal`: niente opacità 0 nell'HTML (AC30). L'entrata, una volta per visita, la arma lo
 * stesso script inline (`data-armed`, come la parete clienti) e la fa partire l'IntersectionObserver del modulo
 * (`data-in`): senza JS tutto resta visibile.
 */
import Scheda from './showcase/Scheda.astro';
import Filtri from './showcase/Filtri.astro';
import Feed from './showcase/Feed.astro';
import { getArticles, annoRif } from '../data/articoli';
import { ctaLabel, dayMonth, monthOf } from '../data/articoli-testi';

const LIMITE = 8;
const articoli = await getArticles();
const anno = annoRif(articoli);
const n = articoli.length;
const piuRecente = articoli[0].date;
const daMese = monthOf(articoli[n - 1].date);

const primi = (tag?: string) => articoli.filter((a) => !tag || a.tag === tag).slice(0, LIMITE);
const visibili = new Set(primi().map((a) => a.id));
const unione = new Set([...visibili, ...primi('caso-studio').map((a) => a.id), ...primi('release').map((a) => a.id)]);
const schede = articoli.filter((a) => unione.has(a.id));
const etichetta = ctaLabel('all', n);
---

<section class="showcase" id="shipped" data-showcase-home>
  <div class="wrap">
    <div class="section-head">
      <div class="eyebrow"><span class="num">04</span> La prova</div>
      <h2 lang="en">Code is cheap. Show me production.</h2>
      <p class="lead">
        Cosa ho portato davvero in produzione: singole feature, casi studio di grandi progetti e ricerche personali che
        porto avanti.
      </p>
      <p class="sh-stat">
        <b>{n} articoli da {daMese}</b> · l'ultimo <time datetime={piuRecente} data-rel-riga>il {dayMonth(piuRecente, anno)}</time>
      </p>
    </div>
    <div class="sh-tools">
      <Filtri articoli={articoli} />
      {/* frecce della fila: solo con JS e con un puntatore fine (src/scripts/fila.ts) */}
      <div class="sc-arrows" data-arrows>
        <button type="button" class="sc-arrow solo-js" data-fila-prev aria-label="Articoli più recenti" aria-disabled="true" hidden>
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" class="sc-arrow solo-js" data-fila-next aria-label="Articoli meno recenti" hidden>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>

  <ol class="sc-strip" aria-label="Ultimi articoli">
    {
      schede.map((a) => (
        <li data-tag={a.tag} hidden={!visibili.has(a.id)}>
          <Scheda a={a} anno={anno} variant="home" />
        </li>
      ))
    }
    <li class="sc-strip-fine" aria-hidden="true">
      <a class="sc-card sc-all" href="/showcase/" tabindex="-1" data-cta>
        <b data-cta-label>{etichetta}</b> <span>→</span>
      </a>
    </li>
  </ol>

  <div class="wrap">
    <div class="hf">
      <a class="hf-all" href="/showcase/" data-cta>
        <span data-cta-label>{etichetta}</span> <span aria-hidden="true">→</span>
      </a>
      <Feed />
    </div>
  </div>
</section>
{/* prima del primo paint: rivela i controlli e arma l'entrata (lo stato nascosto esiste solo con JS) */}
<script is:inline>
  (() => {
    const s = document.currentScript.previousElementSibling;
    s.querySelectorAll('.solo-js').forEach((el) => el.removeAttribute('hidden'));
    s.setAttribute('data-js', '');
    s.setAttribute('data-armed', '');
  })();
</script>

<script>
  import { aggiornaDate, bindFeed, bindTags, riparti, tieniVisibile } from '../scripts/showcase';
  import { bindFila } from '../scripts/fila';
  import { isTag, type TagFilter } from '../data/articoli-testi';

  const section = document.querySelector<HTMLElement>('[data-showcase-home]');
  if (section) {
    const strip = section.querySelector<HTMLElement>('.sc-strip');
    const fine = section.querySelector<HTMLElement>('.sc-strip-fine');

    // entrata: una volta sola, al 15% di visibilità; poi l'observer si stacca e tornare non la rifà
    const entrata = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return;
        section.setAttribute('data-in', '');
        entrata.disconnect();
      },
      { threshold: 0.15 }
    );
    entrata.observe(section);

    // filtro e posizione della fila nella voce di cronologia (senza toccare l'indirizzo): tornando con Indietro
    // senza bfcache la pagina si ricarica e li ritrova. Con bfcache la pagina torna com'era e questo non serve.
    let tagCorrente: TagFilter = 'all';
    const salva = () => {
      const fila = { tag: tagCorrente, left: strip?.scrollLeft ?? 0 };
      history.replaceState({ ...(history.state || {}), fila }, '');
    };

    const fila = bindFila(section, { onFermo: salva });
    const tags = bindTags(section, {
      limit: 8,
      onChange: (tag, { iniziale, shown }) => {
        tagCorrente = tag;
        // anche alla prima applicazione: la fila parte sempre dall'inizio con le frecce allineate
        fila.reset();
        salva();
        if (iniziale) return;
        // un filtro scelto vuol dire che la sezione è già entrata: la fila si «assesta» (le schede che
        // ricompaiono non rifanno l'entrata lunga), intestazione e piede no
        section.setAttribute('data-in', '');
        strip?.setAttribute('data-settled', '');
        riparti(section, fine ? [...shown, fine] : shown);
      },
    });

    const nav = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
    const salvato = history.state?.fila as { tag?: unknown; left?: unknown } | undefined;
    if (nav?.type === 'back_forward' && salvato) {
      // filtro di prima senza animazione né annuncio; la posizione dopo il reset (il suo rAF gira prima di questo)
      tags.apply(typeof salvato.tag === 'string' && isTag(salvato.tag) ? salvato.tag : 'all', { iniziale: true });
      const left = Number(salvato.left) || 0;
      requestAnimationFrame(() => {
        fila.ripristina(left);
        salva();
      });
    }
    bindFeed(section);
    aggiornaDate(section);
    tieniVisibile(section);
  }
</script>

<style is:global>
  .showcase {
    --t-ink: #fff;
    --t-muted: #9aa3b5;
    --t-faint: #848ea6;
    --t-line: rgba(255, 255, 255, 0.12);
    --t-line-strong: rgba(255, 255, 255, 0.32);
    --t-accent: #8a93ff;
    --t-hover: rgba(255, 255, 255, 0.05);
    --t-card: rgba(255, 255, 255, 0.04);
    background: var(--ink);
    color: var(--t-ink);
    padding: 112px 0 104px;
    overflow: clip;
  }
  .showcase .eyebrow,
  .showcase .lead {
    color: var(--t-muted);
  }
  .showcase .eyebrow .num {
    color: var(--t-accent);
  }
  .showcase .section-head {
    margin-bottom: 0;
  }
  .sh-stat {
    margin-top: 20px;
    font-size: 0.95rem;
    color: var(--t-muted);
  }
  .sh-stat b {
    color: var(--t-ink);
    font-weight: 600;
  }

  /* filtri a sinistra, frecce a destra */
  .sh-tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: 40px;
  }
  /* frecce: solo con un puntatore fine (mouse, trackpad) e solo con JS; su touch si scorre col dito */
  .sh-tools .sc-arrows {
    display: none;
    gap: 8px;
    flex: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .showcase[data-js] .sh-tools .sc-arrows {
      display: flex;
    }
  }
  /* la fila non scorre: le frecce spariscono ma tengono il loro spazio, la riga dei controlli non cambia altezza */
  .sh-tools .sc-arrows[data-ferma] {
    visibility: hidden;
  }
  .sc-arrow {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border-radius: 50%;
    border: 1px solid var(--t-line);
    background: transparent;
    color: var(--t-ink);
    font: inherit;
    font-size: 1.1rem;
    cursor: pointer;
    transition:
      background-color var(--dur-hover) var(--ease-out),
      opacity var(--dur-hover) var(--ease-out),
      transform var(--dur-press) var(--ease-press);
  }
  .sc-arrow[hidden] {
    display: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .sc-arrow:hover:not([aria-disabled='true']) {
      background-color: var(--t-hover);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .sc-arrow:active:not([aria-disabled='true']) {
      transform: scale(0.95);
    }
  }
  /* all'estremità: resta raggiungibile con Tab, ma non agisce */
  .sc-arrow[aria-disabled='true'] {
    opacity: 0.35;
    cursor: default;
  }
  .sc-arrow:focus-visible {
    outline: 2px solid var(--t-accent);
    outline-offset: 2px;
  }

  /* chip sul fondo scuro (l'hover del bordo usa --t-line-strong, in Filtri.astro) */
  .showcase .sc-chips .chip {
    background: transparent;
  }
  .showcase .sc-chips .chip[aria-pressed='true'] {
    background: #fff;
    border-color: #fff;
    color: var(--ink);
  }
  .showcase .sc-chips .chip[aria-pressed='true'] .chip-n {
    color: var(--muted);
  }

  /* fila: parte allineata al contenuto e arriva al bordo dello schermo */
  .sc-strip {
    --gutter: max(24px, calc((100vw - var(--max)) / 2 + 24px));
    display: flex;
    gap: 16px;
    list-style: none;
    margin: 24px 0 0;
    padding: 4px var(--gutter) 12px;
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scrollbar-width: none;
  }
  .sc-strip::-webkit-scrollbar {
    display: none;
  }
  .sc-strip > li {
    flex: 0 0 320px;
    display: flex;
    scroll-snap-align: start;
  }
  .sc-strip > li[hidden] {
    display: none;
  }
  .sc-all {
    justify-content: center;
    align-items: center;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 10px;
    padding: 24px;
    text-align: center;
    background: transparent;
    border-style: dashed;
  }
  .sc-all b {
    font-size: 1.25rem;
  }
  .sc-all span {
    font-size: 1.5rem;
    color: var(--t-accent);
  }

  /* piede: link a tutti gli articoli + feed */
  .hf {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 40px;
  }
  .hf-all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 22px;
    border-radius: 999px;
    background: #fff;
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--dur-hover) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .hf-all:hover {
      transform: translateY(-1px);
    }
  }
  /* la pressione non dipende dall'hover: vale anche al tocco */
  @media (prefers-reduced-motion: no-preference) {
    .hf-all:active {
      transform: scale(0.97);
      transition-duration: var(--dur-press);
      transition-timing-function: var(--ease-press);
    }
  }
  .hf-all:focus-visible {
    outline: 2px solid var(--t-accent);
    outline-offset: 3px;
  }

  /* ---------- entrata, una volta per visita ---------- */
  /* Keyframe con fill "backwards": a fine animazione ogni elemento torna ai propri stili (e alle proprie
     transition di hover e pressione). Nascosti solo se lo script inline ha armato la sezione (AC30).
     Ritardo `--stagger × --i`: eyebrow e titolo 0, lead 1, riga del conteggio e controlli 2, schede 3
     (tutte insieme), piede 4. Intestazione e schede salgono, controlli e piede solo in dissolvenza. */
  .showcase .eyebrow,
  .showcase .section-head h2 {
    --i: 0;
  }
  .showcase .lead {
    --i: 1;
  }
  .sh-stat,
  .sh-tools {
    --i: 2;
  }
  .sc-strip > li {
    --i: 3;
  }
  .hf {
    --i: 4;
  }
  .showcase[data-armed]:not([data-in]) :is(.section-head > *, .sh-tools, .sc-strip > li, .hf) {
    opacity: 0;
  }
  .showcase[data-in] :is(.section-head > *, .sc-strip:not([data-settled]) > li) {
    animation: sh-rise var(--dur-reveal) var(--ease-out-expo) backwards;
    animation-delay: calc(var(--stagger) * var(--i));
  }
  .showcase[data-in] :is(.sh-tools, .hf) {
    animation: sh-fade var(--dur-reveal) var(--ease-out-expo) backwards;
    animation-delay: calc(var(--stagger) * var(--i));
  }
  @keyframes sh-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes sh-fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    /* in sola dissolvenza, come .reveal: niente salita, stessi ritardi */
    .showcase[data-in] :is(.section-head > *, .sc-strip:not([data-settled]) > li, .sh-tools, .hf) {
      animation-name: sh-fade;
      animation-duration: var(--dur-swap);
      animation-timing-function: linear;
    }
  }

  @media (max-width: 700px) {
    .showcase {
      padding: 80px 0 72px;
    }
    .sc-strip > li {
      flex-basis: min(82vw, 340px);
    }
  }
</style>
