---
import '../styles/global.css';
import { SITE } from '../config';
import { type LdNode, ldJson, sharedGraph } from '../seo';

interface Props {
  title?: string;
  description?: string;
  /** 'default' = nav completa · 'case-study' = logo + link di ritorno · 'article' = logo + «← Tutti gli articoli» (indietro nella cronologia se si arriva da /showcase/) · 'minimal' = solo logo */
  nav?: 'default' | 'case-study' | 'article' | 'minimal';
  active?: 'pricing' | 'showcase';
  /** CTA flottante "Prenota una call" — da spegnere sulle pagine post-vendita */
  floatCta?: boolean;
  /** Pagine operative (es. /benvenuto) da tenere fuori dai motori di ricerca */
  noindex?: boolean;
  /** og:type: 'article' sui casi studio */
  ogType?: 'website' | 'article';
  /** Nodi JSON-LD della pagina (es. Article), aggiunti al grafo condiviso di src/seo.ts */
  jsonLd?: LdNode[];
}

const {
  title = SITE.title,
  description = SITE.description,
  nav = 'default',
  active,
  floatCta = true,
  noindex = false,
  ogType = 'website',
  jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const structuredData = ldJson([...sharedGraph(Astro.site!), ...jsonLd]);
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="it_IT" />
    {/* Anteprima social generica (public/og.png): logo, titolo della hero e claim, niente dati che invecchiano */}
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="spatalo.tech — Building products that solve real problems. Product engineering in abbonamento." />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Showcase`} href="/rss.xml" />
    <script is:inline type="application/ld+json" set:html={structuredData} />
  </head>
  <body>
    <nav>
      <div class="wrap nav-inner">
        <a class="logo" href="/">spatalo<span>.</span>tech</a>
        {
          nav === 'case-study' ? (
            <a class="back" href="/showcase/?tag=caso-studio">← Tutti i casi studio</a>
          ) : nav === 'article' ? (
            <a class="back" href="/showcase/" data-back-showcase>← Tutti gli articoli</a>
          ) : nav === 'minimal' ? null : (
            <div class="nav-links">
              <a href="/#modello">Come funziona</a>
              <a href="/#confronto">Confronto</a>
              <a href="/showcase/" class:list={[{ 'active-link': active === 'showcase' }]} aria-current={active === 'showcase' ? 'page' : undefined}>Showcase</a>
              <a href="/pricing" class:list={[{ 'active-link': active === 'pricing' }]} aria-current={active === 'pricing' ? 'page' : undefined}>Prezzi</a>
              <a class="btn btn-primary" href={SITE.calUrl} target="_blank" rel="noopener">Prenota una call</a>
            </div>
          )
        }
      </div>
    </nav>

    <slot />

    <footer>
      <div class="wrap footer-inner">
        <span>© 2026 {SITE.name}, lo studio di product engineering fondato da {SITE.founder}</span>
        <span>
          <a href={SITE.linkedin} target="_blank" rel="noopener">LinkedIn</a> ·
          <a href={`mailto:${SITE.email}`}>Email</a> ·
          <a href="/termini">Termini</a>
        </span>
      </div>
    </footer>

    {
      floatCta && (
        <a class="float-cta" href={SITE.calUrl} target="_blank" rel="noopener">
          <span class="fc-long">Review gratuita del tuo prodotto.&nbsp;</span>
          <strong>Prenota 30 minuti&nbsp;→</strong>
        </a>
      )
    }

    <script>
      /* ----- scroll reveal ----- */
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.15 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      /* ----- «← Tutti gli articoli»: torna indietro nella cronologia (ritrova filtro e posizione) solo se si arriva da /showcase/ ----- */
      const back = document.querySelector<HTMLAnchorElement>('[data-back-showcase]');
      if (back) {
        back.addEventListener('click', (e) => {
          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          let daShowcase = false;
          try {
            const ref = new URL(document.referrer);
            daShowcase = ref.origin === location.origin && ref.pathname === '/showcase/';
          } catch {}
          if (daShowcase && history.length > 1) {
            e.preventDefault();
            history.back();
          }
        });
      }

      /* ----- floating CTA ----- */
      const fc = document.querySelector('.float-cta');
      if (fc) {
        const toggle = () => fc.classList.toggle('show', window.scrollY > 480);
        window.addEventListener('scroll', toggle, { passive: true });
        toggle();
      }
    </script>
  </body>
</html>
