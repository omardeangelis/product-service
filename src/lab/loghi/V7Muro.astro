---
/*
 * Variante · Muro (creativa) — asse: spettacolo d'ambiente, densità visiva.
 * Una parete inclinata in prospettiva, piena di schermate dei clienti su tre file: home, pagine
 * interne e (Valueize) l'app del caso studio, 20 schermate diverse in tutto. Le file non scivolano:
 * avanzano di una finestra alla volta, a scatti, in direzioni alternate e con ritmi diversi, così il
 * muro sembra "lavorare" senza mai fluttuare.
 * Motion:
 *  - entrata: la parete si alza dal piano (rotateX +32° e 80px più in basso, opacity 0) fino alla
 *    sua inclinazione, --dur-showpiece --ease-out-expo (è il pezzo forte della variante);
 *  - scatto di una fila: translateX di una finestra (324px), --dur-reveal --ease-out-expo;
 *    periodi 2.6s / 3.2s / 2.9s per non sincronizzarsi; finito il giro della sua sequenza il nastro
 *    torna al centro senza animare (tre copie della sequenza, nessuno stacco visibile);
 *  - cliente acceso (hover su un suo nome o su una sua schermata, tap su touch): le sue schermate
 *    restano piene col bordo nel suo colore, le altre scendono a .18; il nome si accende sotto.
 *    --dur-ui --ease-out. Col mouse sul muro le file si fermano, sui nomi continuano a scorrere;
 *  - si ferma anche fuori schermo e con la tab nascosta.
 * Reduce: niente scatti né sollevamento, entrata solo in dissolvenza; il muro resta un'immagine,
 * l'accensione per cliente resta (cambia solo l'opacità).
 * Testi: in copy.ts.
 */
import { LOGOS } from './logos';
import { COPY } from './copy';

// [cliente, schermata]: ogni fila mescola i clienti, e ognuna delle 20 schermate compare una volta.
const ROWS: [number, number][][] = [
  [[0, 0], [1, 1], [2, 2], [3, 1], [0, 3], [1, 4], [2, 0]],
  [[3, 2], [2, 1], [0, 1], [1, 0], [3, 4], [2, 4], [0, 4]],
  [[1, 2], [3, 0], [2, 3], [0, 2], [1, 3], [3, 3]],
];
const COPIES = 3;
const PERIODS = [2600, 3200, 2900];
---

<section class="v7" aria-labelledby="v7-h">
  <div class="wrap v7-head lab-fade">
    <div class="v7-lead">
      <p class="v7-eyebrow">{COPY.eyebrow}</p>
      <h2 class="v7-title" id="v7-h">{COPY.title}</h2>
    </div>
    <p class="v7-aside">{COPY.aside}</p>
  </div>

  <div class="v7-stage" aria-hidden="true">
    <div class="v7-plane">
      {
        ROWS.map((seq, r) => (
          <div class="v7-row" data-dir={r % 2 ? 'right' : 'left'} data-period={PERIODS[r]} data-n={seq.length}>
            <div class="v7-track">
              {Array.from({ length: COPIES }, () => seq)
                .flat()
                .map(([c, i]) => {
                  const l = LOGOS[c];
                  const sc = l.screens[i];
                  return (
                    <figure class="v7-win" data-index={c} style={`--tint:${l.tint}`}>
                      <span class="v7-bar">
                        <i />
                        <i />
                        <i />
                        <span>{sc.label}</span>
                      </span>
                      <img src={sc.src} alt="" draggable="false" />
                    </figure>
                  );
                })}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="wrap">
    <ul class="v7-names lab-fade" style="--i:3">
      {
        LOGOS.map((l, i) => {
          const Tag = l.href ? 'a' : 'span';
          return (
            <li data-index={i} style={`--tint:${l.tint}`}>
              <Tag class="v7-name" href={l.href}>
                <b>{l.name}</b>
                <span>
                  {COPY.sub[i]}
                  {l.href && <i>{COPY.caseLabel}</i>}
                </span>
              </Tag>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .v7 {
    --on: #fff;
    --on-muted: rgba(255, 255, 255, 0.55);
    --w: 300px;
    --gap: 24px;
    position: relative;
    overflow: clip;
    background: var(--ink);
    color: var(--on);
    padding: 80px 0 72px;
  }
  .v7-head {
    display: flex;
    justify-content: space-between;
    /* la riga a destra sta sulla linea dell'ultima riga a sinistra (l'etichetta, o il titolo) */
    align-items: last baseline;
    gap: 12px 32px;
    flex-wrap: wrap;
  }
  .v7-lead {
    display: grid;
    gap: 14px;
  }
  .v7-eyebrow,
  .v7-aside {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--on-muted);
  }
  .v7-title {
    max-width: 760px;
    color: var(--on);
    text-wrap: balance;
  }

  /* ---------- la parete ---------- */
  .v7-stage {
    position: relative;
    height: 440px;
    margin: 8px 0 12px;
    perspective: 1600px;
    perspective-origin: 50% 30%;
    /* sfuma sui quattro lati: la parete continua oltre la sezione */
    --fade-x: 14%;
    --fade-y: 20%;
    -webkit-mask-image:
      linear-gradient(to right, transparent, #000 var(--fade-x), #000 calc(100% - var(--fade-x)), transparent),
      linear-gradient(to bottom, transparent, #000 var(--fade-y), #000 calc(100% - var(--fade-y)), transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(to right, transparent, #000 var(--fade-x), #000 calc(100% - var(--fade-x)), transparent),
      linear-gradient(to bottom, transparent, #000 var(--fade-y), #000 calc(100% - var(--fade-y)), transparent);
    mask-composite: intersect;
  }
  .v7-plane {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    justify-items: center;
    gap: var(--gap);
    translate: -50% -50%;
    transform: rotateX(32deg) rotateZ(-14deg);
  }
  .v7-row {
    /* la fila centrale parte mezza finestra più in là: niente colonne allineate */
    margin-left: calc(var(--row-shift, 0) * var(--w));
  }
  .v7-row:nth-child(2) {
    --row-shift: -0.5;
  }
  .v7-track {
    display: flex;
    gap: var(--gap);
    width: max-content;
    /* --k = finestre di cui il nastro (centrato) è avanzato: fino a ± la lunghezza della sequenza, poi torna a 0 */
    transform: translateX(calc(var(--k, 0) * (var(--w) + var(--gap)) * -1));
    transition: transform var(--dur-reveal) var(--ease-out-expo);
  }
  .v7-win {
    flex: none;
    width: var(--w);
    margin: 0;
    overflow: hidden;
    border-radius: 8px;
    background: #fff;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.06),
      0 20px 40px rgba(0, 0, 0, 0.35);
    transition:
      transform var(--dur-ui) var(--ease-out),
      box-shadow var(--dur-ui) var(--ease-out),
      opacity var(--dur-ui) var(--ease-out);
  }
  .v7-bar {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 18px;
    padding: 0 8px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .v7-bar i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--line);
  }
  .v7-bar span {
    flex: 1;
    min-width: 0;
    margin: 0 26px 0 6px;
    overflow: hidden;
    font-size: 0.6rem;
    color: var(--muted);
    text-align: center;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .v7-win img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    -webkit-user-drag: none;
  }
  /* cliente acceso: le sue schermate piene e bordate nel suo colore, le altre in secondo piano */
  .v7[data-hot='0'] .v7-win:not([data-index='0']),
  .v7[data-hot='1'] .v7-win:not([data-index='1']),
  .v7[data-hot='2'] .v7-win:not([data-index='2']),
  .v7[data-hot='3'] .v7-win:not([data-index='3']) {
    opacity: 0.18;
  }
  .v7[data-hot='0'] .v7-win[data-index='0'],
  .v7[data-hot='1'] .v7-win[data-index='1'],
  .v7[data-hot='2'] .v7-win[data-index='2'],
  .v7[data-hot='3'] .v7-win[data-index='3'] {
    box-shadow:
      0 0 0 2px var(--tint),
      0 28px 56px rgba(0, 0, 0, 0.45);
  }
  @media (hover: hover) and (pointer: fine) {
    .v7-win:hover {
      transform: scale(1.06);
    }
  }

  /* ---------- nomi ---------- */
  .v7-names {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .v7-names li {
    /* grid: il link si allunga a tutta l'altezza della riga, così l'area cliccabile è quella del hover */
    display: grid;
    cursor: default;
  }
  .v7-name {
    display: grid;
    /* il link è alto quanto la riga: le tracce restano in alto, così le righe sotto i nomi si allineano */
    align-content: start;
    gap: 4px;
    padding-top: 14px;
    border-top: 2px solid rgba(255, 255, 255, 0.14);
    color: inherit;
    text-decoration: none;
    transition:
      border-color var(--dur-ui) var(--ease-out),
      opacity var(--dur-ui) var(--ease-out);
  }
  .v7-name b {
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .v7-name span {
    font-size: 0.85rem;
    color: var(--on-muted);
  }
  /* "caso studio ↗" su una riga sua a ogni larghezza: mai una riga che comincia con un separatore */
  .v7-name i {
    display: block;
    font-style: normal;
    white-space: nowrap;
  }
  .v7[data-hot] .v7-names li:not([data-on]) .v7-name {
    opacity: 0.4;
  }
  .v7-name:focus-visible {
    outline: 2px solid var(--on);
    outline-offset: 4px;
  }
  .v7-names li[data-on] .v7-name {
    border-color: var(--tint);
  }


  /* ---------- entrata: la parete si alza (solo con JS: lo stato nascosto lo mette data-armed) ---------- */
  :global([data-armed]:not([data-in])) .v7-plane {
    opacity: 0;
  }
  :global([data-in]) .v7-plane {
    animation: v7-rise var(--dur-showpiece) var(--ease-out-expo) backwards;
    animation-delay: var(--stagger);
  }
  @keyframes v7-rise {
    from {
      opacity: 0;
      transform: translateY(80px) rotateX(64deg) rotateZ(-14deg);
    }
  }

  @media (max-width: 760px) {
    .v7 {
      --w: 200px;
      --gap: 16px;
      padding: 64px 0 56px;
    }
    .v7-stage {
      height: 300px;
      --fade-x: 10%;
    }
    .v7-bar {
      height: 12px;
    }
    .v7-bar span {
      display: none;
    }
    .v7-names {
      grid-template-columns: 1fr 1fr;
      gap: 20px 16px;
    }
    .v7-name b {
      font-size: 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global([data-in]) .v7-plane {
      animation-name: lab-fade;
      animation-timing-function: linear;
    }
    .v7-track {
      transition: none;
    }
    .v7-win:hover {
      transform: none;
    }
  }
</style>
