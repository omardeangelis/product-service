---
/*
 * Lab "Hanno lavorato con me": la variante scelta (Muro, testi in copy.ts) nel contesto reale, hero sopra
 * e "Per chi" sotto. È il riferimento vivo della spec finché l'implementazione non arriva in produzione.
 * Solo dev: la rotta la inietta src/prototypes/integration.mjs. Nessun file di produzione importa da src/lab/.
 */
import Base from '../../layouts/Base.astro';
import { SITE } from '../../config';
import V7Muro from './V7Muro.astro';
---

<Base title="Lab · Hanno lavorato con me" floatCta={false} noindex>
  <!-- contesto: hero com'è in home -->
  <header class="hero">
    <div class="wrap">
      <div class="badge">2 slot disponibili</div>
      <h1>Building products that<br />solve <em>real problems</em>.</h1>
      <p class="lead">
        <strong>Product engineering in abbonamento</strong>: un prezzo fisso al mese e un senior che pensa al prodotto,
        non solo al codice. <strong>Nel tuo team, o sotto il tuo marchio in white label.</strong> Attivi in 24 ore, in
        pausa quando vuoi.
      </p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href={SITE.calUrl} target="_blank" rel="noopener">Prenota una call di 30 min</a>
        <a class="btn btn-ghost" href="#">Show me the code ↓</a>
      </div>
      <div class="hero-proof">
        <div class="proof"><b>10 anni</b><span>di prodotti in produzione</span></div>
        <div class="proof"><b>24h</b><span>per iniziare, non mesi</span></div>
        <div class="proof"><b>0</b><span>meeting inutili</span></div>
        <div class="proof"><b>∞</b><span>pause quando vuoi</span></div>
      </div>
    </div>
  </header>

  <div id="lab-stage"><V7Muro /></div>

  <!-- contesto: "Per chi" com'è in home (primo pannello, statico) -->
  <section id="per-chi">
    <div class="wrap who">
      <div><div class="eyebrow"><span class="num">00</span> Per chi</div></div>
      <div class="who-chips">
        <button class="active">Scale-up</button>
        <button>Agency</button>
        <button>Startup</button>
      </div>
      <p class="big">Il backlog è più veloce dell'hiring?<br /><em>Sblocco le feature</em> mentre il recruiting fa il suo corso.</p>
      <div class="who-proof">
        <span><b>Seniority garantita</b> · 10 anni di produzione</span>
        <span><b>Visione di prodotto</b> · non solo esecuzione</span>
        <span><b>Pause libere</b> · sospendi in un click</span>
      </div>
    </div>
  </section>
  <div style="height:40vh"></div>

</Base>

<script>
  import { initMuro } from './muro';

  const section = document.querySelector<HTMLElement>('#lab-stage > section')!;

  // Entrata come i .reveal del sito, ma visibile di default: lo stato nascosto lo mette lo script.
  section.setAttribute('data-armed', '');
  const io = new IntersectionObserver(
    (entries) => {
      if (entries.some((e) => e.isIntersecting)) {
        section.setAttribute('data-in', '');
        io.disconnect();
      }
    },
    { threshold: 0.15 }
  );
  io.observe(section);
  initMuro(section);
</script>

<style>
  /* ---------- contesto: copia degli stili di hero e "Per chi" da src/pages/index.astro ---------- */
  .hero {
    padding: 120px 0 96px;
  }
  .hero .badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--ok-soft);
    color: var(--ok);
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 28px;
  }
  .hero .badge::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }
  .hero h1 em {
    font-style: normal;
    color: var(--accent);
  }
  .hero .lead {
    margin: 24px 0 40px;
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }
  .hero-proof {
    display: flex;
    gap: 48px;
    flex-wrap: wrap;
    margin-top: 72px;
    padding-top: 40px;
    border-top: 1px solid var(--line);
  }
  .proof b {
    display: block;
    font-size: 1.9rem;
    letter-spacing: -0.03em;
  }
  .proof span {
    color: var(--muted);
    font-size: 0.9rem;
  }
  #per-chi {
    background: var(--surface);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding: 88px 0;
  }
  .who {
    max-width: 880px;
    margin: 0 auto;
    text-align: center;
  }
  .who-chips {
    display: inline-flex;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px;
    margin-bottom: 44px;
  }
  .who-chips button {
    border: 0;
    background: transparent;
    padding: 12px 30px;
    border-radius: 999px;
    font-size: 0.98rem;
    font-weight: 600;
    color: var(--muted);
    font-family: inherit;
  }
  .who-chips button.active {
    background: var(--ink);
    color: #fff;
  }
  .who p.big {
    font-size: clamp(1.5rem, 3.2vw, 2.2rem);
    line-height: 1.3;
    font-weight: 700;
    letter-spacing: -0.025em;
    max-width: 820px;
    margin: 0 auto 32px;
  }
  .who p.big em {
    font-style: normal;
    color: var(--accent);
  }
  .who-proof {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .who-proof span {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 9px 20px;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--muted);
  }
  .who-proof span b {
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .hero {
      padding: 80px 0 64px;
    }
    .hero-proof {
      gap: 28px;
    }
    #per-chi {
      padding: 64px 0;
    }
  }
  @media (max-width: 640px) {
    .who-chips button {
      padding: 11px 18px;
      font-size: 0.9rem;
    }
  }
</style>

<style is:global>
  /* ---------- entrate della sezione ---------- */
  /* Entrate: keyframe con fill "backwards", così a fine animazione ogni elemento torna
     alla propria opacità e alle proprie transition di hover. Nascosti solo se lo script arma la sezione. */
  [data-armed]:not([data-in]) .lab-rise,
  [data-armed]:not([data-in]) .lab-fade {
    opacity: 0;
  }
  [data-in] .lab-rise {
    animation: lab-rise var(--dur-reveal) var(--ease-out-expo) backwards;
    animation-delay: calc(var(--stagger) * var(--i, 0));
  }
  [data-in] .lab-fade {
    animation: lab-fade var(--dur-reveal) var(--ease-out-expo) backwards;
    animation-delay: calc(var(--stagger) * (var(--i, 0) + 1));
  }
  @keyframes lab-rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }
  @keyframes lab-fade {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-in] .lab-rise {
      animation-name: lab-fade;
      animation-duration: var(--dur-swap);
      animation-timing-function: linear;
    }
  }
</style>
